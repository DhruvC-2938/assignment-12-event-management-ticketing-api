{
  "info": {
    "_postman_id": "event-ticketing-api-v1",
    "name": "Event Management & Ticketing REST API (Firebase & Swagger)",
    "description": "Comprehensive Postman collection for Assignment 12 Event Ticketing API demonstrating Organizer event management, Attendee atomic ticket booking, rate limiting, and cancellation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "organizerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "attendeeToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Organizer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Event Horizon\",\n  \"email\": \"organizer@events.com\",\n  \"password\": \"password123\",\n  \"role\": \"Organizer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Attendee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kunal Sharma\",\n  \"email\": \"kunal@gmail.com\",\n  \"password\": \"password123\",\n  \"role\": \"Attendee\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@events.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "2. Event Management",
      "item": [
        {
          "name": "List All Events (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?category=Technology&city=Mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "category", "value": "Technology" },
                { "key": "city", "value": "Mumbai" }
              ]
            }
          }
        },
        {
          "name": "Get Event Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
          }
        },
        {
          "name": "Create Event (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Global Cloud & AI Summit 2026\",\n  \"description\": \"Annual flagship backend and AI conference\",\n  \"category\": \"Technology\",\n  \"eventDate\": \"2026-06-15T09:00:00.000Z\",\n  \"venue\": \"Bandra Kurla Complex, Mumbai\",\n  \"ticketPrice\": 1499,\n  \"totalCapacity\": 500\n}"
            },
            "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
          }
        },
        {
          "name": "Update Event (Organizer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketPrice\": 1699\n}"
            },
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}"] }
          }
        },
        {
          "name": "Get Event Registered Attendees (Organizer)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": { "raw": "{{baseUrl}}/events/{{eventId}}/attendees", "host": ["{{baseUrl}}"], "path": ["events", "{{eventId}}", "attendees"] }
          }
        }
      ]
    },
    {
      "name": "3. Ticket Booking & Concurrency",
      "item": [
        {
          "name": "Book Ticket (Attendee - Transaction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2,\n  \"attendeeName\": \"Kunal Sharma\",\n  \"attendeeEmail\": \"kunal@gmail.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tickets/book", "host": ["{{baseUrl}}"], "path": ["tickets", "book"] }
          }
        },
        {
          "name": "Get My Purchased Tickets (Attendee)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/my-tickets", "host": ["{{baseUrl}}"], "path": ["tickets", "my-tickets"] }
          }
        },
        {
          "name": "Cancel Ticket (Restore Capacity)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }],
            "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/cancel", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "cancel"] }
          }
        }
      ]
    }
  ]
}
